<Project>
  <PropertyGroup>
    <!--
      Single source of truth for binary version numbers.
      Local builds default to 1.0.0.0; CI passes the real version by running:
        dotnet build RunAsHelper.sln -c Release -p:ProductVersion=X.Y.Z
      The wixproj forwards ProductVersion to dotnet publish so the EXEs in the
      MSI report the same FileVersion as the MSI ProductVersion.
    -->
    <Version Condition="'$(ProductVersion)' != '' and '$(ProductVersion)' != '1.0.0.0'">$(ProductVersion)</Version>
    <Version Condition="'$(Version)' == ''">1.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>
</Project>
