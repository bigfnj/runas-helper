<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build: Build the solution in VS (Release|x64). The installer project
  publishes both apps as self-contained single-file win-x64 binaries
  before the WiX compiler runs, so no external .NET runtime is required
  on target machines.

  Install silently:  msiexec /i RunAsHelper-Setup.msi /passive
  Uninstall:         msiexec /x RunAsHelper-Setup.msi /passive
-->

<?define ServiceExe = "publish\service\RunAsHelper.Service.exe" ?>
<?define ClientExe  = "publish\client\RunAsHelper.exe" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="RunAS Helper"
           Manufacturer="Serenity Industries"
           Version="$(var.ProductVersion)"
           UpgradeCode="E5F60718-C9DA-1234-EF01-5F6071829304"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RunAS Helper is already installed." />

    <!-- Apps &amp; Features entry: show the product icon instead of a blank tile. -->
    <Icon Id="RunAsHelper.ico" SourceFile="..\power.ico" />
    <Property Id="ARPPRODUCTICON" Value="RunAsHelper.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Embed the payload cabinet inside the MSI so RunAsHelper-Setup.msi is a
         single self-contained file. Without this, WiX v4 emits an external
         cab1.cab next to the MSI and install fails if it is shipped alone. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Install directory ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RunAsHelper">

        <!-- Windows service binary (apphost + ServiceInstall KeyPath) -->
        <Component Id="ServiceComponent" Guid="F6071829-DAEB-2345-F012-607182930415">
          <File Id="ServiceExe"
                Source="$(var.ServiceExe)"
                KeyPath="yes" />
          <ServiceInstall Id="RunASHelperInstall"
                          Type="ownProcess"
                          Name="RunASHelper"
                          DisplayName="RunAS Helper"
                          Description="Provides helper services to applications or users that require elevated privileges for systems administration and troubleshooting."
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="RunASHelperControl"
                          Name="RunASHelper"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Tray client binary (apphost KeyPath) -->
        <Component Id="ClientComponent" Guid="07182930-EBF6-3456-0123-718293041526">
          <File Id="ClientExe"
                Source="$(var.ClientExe)"
                KeyPath="yes" />
        </Component>

        <!-- Task definition XML — registered as the logon scheduled task below. -->
        <Component Id="TaskXmlComponent" Guid="C9DA0E1F-2B3C-4D5E-6F70-8192A3B4C5D6">
          <File Id="TaskXml" Source="task.xml" KeyPath="yes" />
        </Component>

        <!-- Marker that tells the tray app to run its post-install validation
             popup the first time it starts after this install. The tray reads
             it, validates, then records the version under HKCU so it shows once. -->
        <Component Id="ValidationFlagComponent" Guid="1A2B3C4D-5E6F-7081-92A3-B4C5D6E7F809">
          <RegistryValue Root="HKLM"
                         Key="Software\RunAsHelper"
                         Name="PendingValidation"
                         Type="string"
                         Value="[ProductVersion]"
                         KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RunAsHelperMenuFolder" Name="RunAS Helper">
        <Component Id="StartMenuComponent" Guid="28394150-7081-6789-3456-940516370748">
          <Shortcut Id="StartMenuShortcut"
                    Name="RunAS Helper"
                    Target="[INSTALLFOLDER]RunAsHelper.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RunAsHelperMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RunAsHelper"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ── Scheduled task custom actions ─────────────────────────────── -->
    <!--
      Machine-wide task: triggers at logon of ANY member of BUILTIN\Administrators,
      runs with the logged-on user's elevated interactive token — no UAC prompt.
      The CAs run as SYSTEM (Impersonate="no") so they can write to the machine
      task folder (\Microsoft\Windows\Task Scheduler).

      schtasks.exe is used instead of PowerShell so the command stays well under
      the MSI CustomAction.Target column's 255-char schema limit, and because
      schtasks is a system binary not subject to PowerShell execution policy.
      The group-based principal (BUILTIN\Administrators) is expressed in task.xml,
      which schtasks imports — it cannot be expressed on the schtasks command line.
    -->

    <CustomAction Id="SetInstallTask"
                  Property="InstallRunASHelperTask"
                  Value="&quot;schtasks.exe&quot; /create /xml &quot;[INSTALLFOLDER]task.xml&quot; /tn &quot;RunAS Helper&quot; /f" />

    <CustomAction Id="InstallRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="SetDeleteTask"
                  Property="DeleteRunASHelperTask"
                  Value="&quot;schtasks.exe&quot; /delete /tn &quot;RunAS Helper&quot; /f" />

    <CustomAction Id="DeleteRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetInstallTask"        After="CostFinalize" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="InstallRunASHelperTask" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="SetDeleteTask"         After="CostFinalize" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="DeleteRunASHelperTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ── Feature ───────────────────────────────────────────────────── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="TaskXmlComponent" />
      <ComponentRef Id="ValidationFlagComponent" />
    </Feature>

    <!-- ── User interface ────────────────────────────────────────────────
      Without an authored UI the MSI runs with only the bare "basic" progress
      window when double-clicked: no Welcome, no Progress dialog (so the
      "Starting services…" step is invisible), and no Finish dialog. WixUI_Minimal
      gives a Welcome+License page, a real Progress dialog, and an Exit dialog.
      The WixToolset.UI.wixext package reference (in the .wixproj) supplies it.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Exit-dialog "Launch RunAS Helper" checkbox. UNCHECKED by default: the MSI
         UI sequence is NOT elevated, so WixShellExec would start the tray with the
         invoking user's *filtered* (non-elevated) token. That non-elevated instance
         also holds the single-instance mutex, which would then block the elevated
         instance the logon scheduled task starts. Leaving this off lets the
         scheduled task open the tray cleanly (elevated, no UAC prompt) at the next
         sign-in, which is also when the post-install validation runs all-green.
         Power users can still tick it to launch immediately (non-elevated). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RunAS Helper now (non-elevated; sign out/in for full elevation)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="0" />

    <!-- WixShellExec runs as the (impersonated) installing user, so the tray app
         appears on that user's desktop. Reuses the same util CA binary already
         used for the scheduled-task action below. -->
    <Property Id="WixShellExecTarget" Value="[#ClientExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="check" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

  </Package>
</Wix>
