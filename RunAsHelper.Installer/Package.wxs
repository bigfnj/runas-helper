<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build: Build the solution in VS (Release|x64). The installer project runs
  "dotnet publish --self-contained -r win-x64 -p:PublishSingleFile=true"
  for both apps before the WiX compiler runs, so no external .NET runtime
  is required on target machines.

  Install silently:  msiexec /i RunAsHelper-Setup.msi /passive
  Uninstall:         msiexec /x RunAsHelper-Setup.msi /passive
-->

<?define ServiceExe = "publish\service\RunAsHelper.Service.exe" ?>
<?define ClientExe  = "publish\client\RunAsHelper.exe" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="RunAS Helper"
           Manufacturer="bigfnj"
           Version="1.0.0.0"
           UpgradeCode="E5F60718-C9DA-1234-EF01-5F6071829304"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RunAS Helper is already installed." />

    <!-- ── Install directory ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RunAsHelper">

        <!-- Windows service binary (apphost + ServiceInstall KeyPath) -->
        <Component Id="ServiceComponent" Guid="F6071829-DAEB-2345-F012-607182930415">
          <File Id="ServiceExe"
                Source="$(var.ServiceExe)"
                KeyPath="yes" />
          <ServiceInstall Id="RunASHelperInstall"
                          Type="ownProcess"
                          Name="RunASHelper"
                          DisplayName="RunAS Helper"
                          Description="Provides helper services to applications or users that require elevated privileges for systems administration and troubleshooting."
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="RunASHelperControl"
                          Name="RunASHelper"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Tray client binary (apphost KeyPath) -->
        <Component Id="ClientComponent" Guid="07182930-EBF6-3456-0123-718293041526">
          <File Id="ClientExe"
                Source="$(var.ClientExe)"
                KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RunAsHelperMenuFolder" Name="RunAS Helper">
        <Component Id="StartMenuComponent" Guid="28394150-7081-6789-3456-940516370748">
          <Shortcut Id="StartMenuShortcut"
                    Name="RunAS Helper"
                    Target="[INSTALLFOLDER]RunAsHelper.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RunAsHelperMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RunAsHelper"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ── Logon autostart via machine-wide Scheduled Task ───────────── -->
    <!-- KeyPath tracks the component; the task itself is managed below. -->
    <Component Id="StartupComponent"
               Guid="B8C9D0E1-F2A3-4567-CDEF-0A1B2C3D4E5F"
               Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="Software\RunAsHelper"
                     Name="ScheduledTaskInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ── Scheduled task custom actions ─────────────────────────────── -->
    <!--
      Machine-wide task: triggers at logon of ANY member of BUILTIN\Administrators,
      runs with the logged-on user's elevated interactive token — no UAC prompt.
      The CAs run as SYSTEM (Impersonate="no", the default for deferred perMachine CAs)
      so they can write to the machine task folder (\Microsoft\Windows\Task Scheduler).

      PowerShell is used because schtasks.exe cannot express a group-based principal
      in a single command line.

      Return="ignore" prevents a PowerShell error from rolling back the install.
    -->

    <CustomAction Id="SetCreateScheduledTask"
                  Property="CreateRunASHelperTask"
                  Value="powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command &quot;Register-ScheduledTask -TaskName 'RunAS Helper' -Force -Action (New-ScheduledTaskAction -Execute '[INSTALLFOLDER]RunAsHelper.exe') -Trigger (New-ScheduledTaskTrigger -AtLogOn) -Principal (New-ScheduledTaskPrincipal -GroupId 'BUILTIN\Administrators' -RunLevel Highest) -Settings (New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew)&quot;" />

    <CustomAction Id="CreateRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="CAQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="SetDeleteScheduledTask"
                  Property="DeleteRunASHelperTask"
                  Value="powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -Command &quot;Unregister-ScheduledTask -TaskName 'RunAS Helper' -Confirm:$false -ErrorAction SilentlyContinue&quot;" />

    <CustomAction Id="DeleteRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="CAQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetCreateScheduledTask" After="CostFinalize" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="CreateRunASHelperTask"  After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="SetDeleteScheduledTask" After="CostFinalize" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="DeleteRunASHelperTask"  Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ── Feature ───────────────────────────────────────────────────── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="StartupComponent" />
    </Feature>

  </Package>
</Wix>
