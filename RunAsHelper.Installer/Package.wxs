<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build prerequisites:
    1. Build the solution in the desired configuration first:
         dotnet build ..\RunAsHelper.sln -c Release /p:Platform=x64
    2. Then build the installer:
         dotnet build -c Release /p:Platform=x64
    Or build everything at once from the solution (VS or dotnet build on the .sln).

  Runtime prerequisite: .NET 10 x64 Desktop Runtime must be installed on the target machine.
  Install silently:  msiexec /i RunAsHelper-Setup.msi /passive
  Uninstall:         msiexec /x RunAsHelper-Setup.msi /passive
-->

<?define ServiceExe = "..\RunAsHelper.Service\bin\x64\$(var.Configuration)\net10.0-windows\RunAsHelper.Service.exe" ?>
<?define ClientExe  = "..\RunAsHelper\bin\x64\$(var.Configuration)\net10.0-windows\RunAsHelper.exe" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="RunAS Helper"
           Manufacturer="bigfnj"
           Version="1.0.0.0"
           UpgradeCode="E5F60718-C9DA-1234-EF01-5F6071829304"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RunAS Helper is already installed." />

    <!-- ── Install directory ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RunAsHelper">

        <!-- Windows service binary -->
        <Component Id="ServiceComponent" Guid="F6071829-DAEB-2345-F012-607182930415">
          <File Id="ServiceExe"
                Source="$(var.ServiceExe)"
                KeyPath="yes" />
          <ServiceInstall Id="RunASHelperInstall"
                          Type="ownProcess"
                          Name="RunASHelper"
                          DisplayName="RunAS Helper"
                          Description="Provides helper services to applications or users that require elevated privileges for systems administration and troubleshooting."
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="RunASHelperControl"
                          Name="RunASHelper"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Tray client binary -->
        <Component Id="ClientComponent" Guid="07182930-EBF6-3456-0123-718293041526">
          <File Id="ClientExe"
                Source="$(var.ClientExe)"
                KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RunAsHelperMenuFolder" Name="RunAS Helper">
        <Component Id="StartMenuComponent" Guid="28394150-7081-6789-3456-940516370748">
          <Shortcut Id="StartMenuShortcut"
                    Name="RunAS Helper"
                    Target="[INSTALLFOLDER]RunAsHelper.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RunAsHelperMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RunAsHelper"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ── Logon autostart via Scheduled Task ────────────────────────── -->
    <!-- KeyPath is a registry marker only; the actual task is           -->
    <!-- created/deleted by the custom actions in InstallExecuteSequence. -->
    <Component Id="StartupComponent"
               Guid="B8C9D0E1-F2A3-4567-CDEF-0A1B2C3D4E5F"
               Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU"
                     Key="Software\RunAsHelper"
                     Name="ScheduledTaskInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ── Scheduled task custom actions ─────────────────────────────── -->
    <!--
      A type-51 (property-set) CA sets the property whose name matches the
      deferred CA; CAQuietExec64 reads it as CustomActionData and runs it
      via cmd.exe.  Impersonate="yes" means the deferred CA runs as the
      installing user (not SYSTEM), so schtasks creates a per-user logon task.
      Return="ignore" keeps a schtasks error from rolling back the install.
    -->

    <CustomAction Id="SetCreateScheduledTask"
                  Property="CreateRunASHelperTask"
                  Value="schtasks.exe /Create /TN &quot;RunAS Helper&quot; /TR &quot;[INSTALLFOLDER]RunAsHelper.exe&quot; /SC ONLOGON /RU &quot;[USERNAME]&quot; /RL HIGHEST /F" />

    <CustomAction Id="CreateRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="CAQuietExec64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="SetDeleteScheduledTask"
                  Property="DeleteRunASHelperTask"
                  Value="schtasks.exe /Delete /TN &quot;RunAS Helper&quot; /F" />

    <CustomAction Id="DeleteRunASHelperTask"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="CAQuietExec64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Property-set CAs (immediate) must precede their deferred consumers -->
      <Custom Action="SetCreateScheduledTask" After="CostFinalize">NOT Installed OR REINSTALL</Custom>
      <Custom Action="CreateRunASHelperTask"  After="InstallFiles">NOT Installed OR REINSTALL</Custom>
      <Custom Action="SetDeleteScheduledTask" After="CostFinalize">REMOVE="ALL"</Custom>
      <Custom Action="DeleteRunASHelperTask"  Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- ── Feature ───────────────────────────────────────────────────── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="StartupComponent" />
    </Feature>

  </Package>
</Wix>
