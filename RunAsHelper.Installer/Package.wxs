<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build: Build the solution in VS (Release|x64). The installer project
  publishes both apps as self-contained single-file win-x64 binaries
  before the WiX compiler runs, so no external .NET runtime is required
  on target machines.

  Install silently:  msiexec /i RunAsHelper-Setup.msi /passive
  Uninstall:         msiexec /x RunAsHelper-Setup.msi /passive
-->

<?define ServiceExe = "publish\service\RunAsHelper.Service.exe" ?>
<?define ClientExe  = "publish\client\RunAsHelper.exe" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Version binds to the packaged service EXE's FileVersion at link time, so
       the MSI version always matches the binaries. That FileVersion comes from
       the git tag for local builds (Directory.Build.props) or -p:ProductVersion
       in CI — either way there is no separate version to keep in sync here. -->
  <Package Name="RunAS Helper"
           Manufacturer="Serenity Software"
           Version="!(bind.FileVersion.ServiceExe)"
           UpgradeCode="E5F60718-C9DA-1234-EF01-5F6071829304"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RunAS Helper is already installed." />

    <!-- ── .NET 10 Desktop Runtime prerequisite ──────────────────────────────
      Both EXEs are framework-dependent as of 2.1.4, so the runtime has to be on
      the machine already. Without this check the MSI would install cleanly and
      then the service would fail to start with only an event-log entry to show
      for it, which is a miserable thing to debug.

      Detection reads the shared host version that every .NET install writes.
      Note the 64-bit view here: the per-framework keys under sharedfx live in
      the 32-bit view (WOW6432Node), but sharedhost is written to the 64-bit one.

      Two honest limits. This proves a .NET host is present, not specifically that
      the WINDOWS DESKTOP band is, and it does not compare versions, because the
      sharedfx key names values by exact patch (10.0.4, 10.0.5, 10.0.10) and MSI
      cannot pattern-match those, while a string compare would rank "9.0.14" above
      "10.0.0". It therefore catches the common case, a machine with no .NET at
      all, and leaves version and band mismatches to the apphost, which shows its
      own dialog naming the required version and linking the download. Chaining
      the runtime install properly needs a Burn bundle, which would make the
      deliverable a .exe rather than a .msi.
    -->
    <Property Id="DOTNETHOSTVERSION" Secure="yes">
      <RegistrySearch Id="DotNetSharedHost"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!--
      Two gates, deliberately, because they cover different UI levels.

      Full UI gets PrereqDlg (below): a real page with a clickable download link
      and a Try Again button. LaunchConditions runs at sequence ~100, long before
      any dialog, so without the UILevel clause here the blunt abort message would
      always win and the nice page would never be reached. UILevel 5 is full UI;
      4 is reduced, 3 basic, 2 none.

      Silent and basic installs (/qn, /qb) have no dialogs at all, so for those
      this condition IS the gate and aborts with the message below.
    -->
    <!-- Backs the prerequisite page's Try Again button. asyncNoWait so this
         session can end immediately afterwards; the replacement re-runs
         AppSearch from scratch. ProgramFiles64Folder is only the working
         directory, chosen because it is already in the Directory table. -->
    <CustomAction Id="RelaunchSetup"
                  Directory="ProgramFiles64Folder"
                  ExeCommand="[System64Folder]msiexec.exe /i &quot;[OriginalDatabase]&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <Launch Condition="Installed OR DOTNETHOSTVERSION OR UILevel &gt; 4"
            Message="RunAS Helper requires the .NET 10 Desktop Runtime (x64), which was not found on this computer. Install it from https://dotnet.microsoft.com/download/dotnet/10.0 and run this installer again." />

    <!-- Apps &amp; Features entry: show the product icon instead of a blank tile. -->
    <Icon Id="RunAsHelper.ico" SourceFile="..\power.ico" />
    <Property Id="ARPPRODUCTICON" Value="RunAsHelper.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Embed the payload cabinet inside the MSI so RunAsHelper-Setup.msi is a
         single self-contained file. Without this, WiX v4 emits an external
         cab1.cab next to the MSI and install fails if it is shipped alone. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Install directory ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RunAsHelper">

        <!-- Windows service binary (apphost + ServiceInstall KeyPath) -->
        <Component Id="ServiceComponent" Guid="F6071829-DAEB-2345-F012-607182930415">
          <File Id="ServiceExe"
                Source="$(var.ServiceExe)"
                KeyPath="yes" />
          <ServiceInstall Id="RunASHelperInstall"
                          Type="ownProcess"
                          Name="RunASHelper"
                          DisplayName="RunAS Helper"
                          Description="Provides helper services to applications or users that require elevated privileges for systems administration and troubleshooting."
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="RunASHelperControl"
                          Name="RunASHelper"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Tray client binary (apphost KeyPath) -->
        <Component Id="ClientComponent" Guid="07182930-EBF6-3456-0123-718293041526">
          <File Id="ClientExe"
                Source="$(var.ClientExe)"
                KeyPath="yes" />
        </Component>

        <!-- Marker that tells the tray app to run its post-install validation
             popup the first time it starts after this install. The tray reads
             it, validates, then records the version under HKCU so it shows once. -->
        <Component Id="ValidationFlagComponent" Guid="1A2B3C4D-5E6F-7081-92A3-B4C5D6E7F809">
          <RegistryValue Root="HKLM"
                         Key="Software\RunAsHelper"
                         Name="PendingValidation"
                         Type="string"
                         Value="[ProductVersion]"
                         KeyPath="yes" />
        </Component>

        <!-- Registers the event source so EventLogHelper can write structured
             entries (IDs 1001–1005) to the Application log without requiring
             CreateEventSource at runtime. ForceDeleteOnUninstall removes the
             key (and its log entries) when the product is uninstalled. -->
        <Component Id="EventSourceComponent" Guid="2B3C4D5E-6F70-8192-A3B4-C5D6E7F80912">
          <RegistryKey Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\RunAsHelper"
                       ForceDeleteOnUninstall="yes">
            <RegistryValue Name="TypesSupported" Type="integer" Value="7" KeyPath="yes" />
          </RegistryKey>
        </Component>

        <!-- RETIRED, kept for re-instatement. See the InstallCertFeature note in
             the Optional trust block below. The public code-signing certificate,
             installed next to the app so the optional trust step could import it.
             Public key only, safe to ship; it simply no longer ships. -->
        <?ifdef InstallCertFeature ?>
        <Component Id="CertFileComponent" Guid="4D5E6F70-8192-A3B4-C5D6-E7F8091A2B3C">
          <File Id="SerenityCer" Source="..\signing\serenity-software.cer" KeyPath="yes" />
        </Component>
        <?endif?>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RunAsHelperMenuFolder" Name="RunAS Helper">
        <Component Id="StartMenuComponent" Guid="28394150-7081-6789-3456-940516370748">
          <Shortcut Id="StartMenuShortcut"
                    Name="RunAS Helper"
                    Target="[INSTALLFOLDER]RunAsHelper.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RunAsHelperMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RunAsHelper"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- No scheduled task. Elevation is on-demand via the tray's Activate flow,
         and the tray registers its own per-user login auto-start (HKCU Run, tray
         icon only) on first run — so there is no elevated, Administrators-keyed
         logon task for endpoint security tooling to flag. -->

    <!-- ── Feature ───────────────────────────────────────────────────── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="ValidationFlagComponent" />
      <ComponentRef Id="EventSourceComponent" />
      <?ifdef InstallCertFeature ?>
      <ComponentRef Id="CertFileComponent" />
      <?endif?>
    </Feature>

    <!-- ── User interface ────────────────────────────────────────────────
      Without an authored UI the MSI runs with only the bare "basic" progress
      window when double-clicked: no Welcome, no Progress dialog (so the
      "Starting services…" step is invisible), and no Finish dialog. WixUI_Minimal
      gives a Welcome+License page, a real Progress dialog, and an Exit dialog.
      The WixToolset.UI.wixext package reference (in the .wixproj) supplies it.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Replace WiX's default artwork, which was a dark red panel and a white
         square holding a disc glyph.

         dialog.bmp (493x312) is the side panel. WixUI_Minimal covers all but the
         leftmost ~165px of it with the licence control, so it is cropped around
         the shield rather than being the whole wide composition scaled down,
         which would have shown only its left edge. The hidden remainder carries
         the artwork's own background colour so nothing seams if a dialog shows
         more of it.

         banner.bmp (493x58) is the strip on the progress page. WixUI draws the
         dialog title over its left side in dark text, so the background stays
         light and only the icon sits on the right, where the disc glyph was.

         Both are 24-bit BMP: WixUI's Bitmap controls do not take PNG. Source
         artwork is RunAsHelper.Shared\security-image.png and power.png; the BMPs
         are generated, not hand-edited. -->
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />

    <!-- Exit-dialog "Launch RunAS Helper" checkbox. CHECKED by default: it starts
         the tray (non-elevated, in the installing user's session) right after
         install. That first run also registers the login auto-start (an HKCU Run
         entry that opens the tray icon only), so it comes up on its own at every
         later sign-in. The old reason to leave it off (a non-elevated tray
         blocking the elevated logon scheduled-task instance via the single-instance
         mutex) no longer applies: the app now elevates on demand via the Activate
         flow rather than relying on the logon task. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RunAS Helper now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Launch the tray as the (impersonated) installing user, so it appears on that
         user's desktop, passing the postinstall switch (see ExeCommand below). That
         switch is what triggers the one-time Installation Check popup: the tray shows
         it ONLY when the installer started it this way, never on an ordinary open, the
         elevation hand-off, or the login tray start. This is an exe custom action rather
         than util's WixShellExec because WixShellExec ShellExecutes WixShellExecTarget
         as a bare file and offers no way to pass arguments. Return is asyncNoWait so a
         launch failure can never fail the install. -->
    <CustomAction Id="LaunchApplication"
                  FileRef="ClientExe"
                  ExeCommand="--postinstall"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- ── RETIRED: trust the self-signed code-signing certificate ──────────
      This whole feature is compiled OUT by default and no longer ships in a
      release. Asking a stranger to add a root CA to their machine is not a thing
      a public download should do, and the private half of that root lives in this
      repository's Actions secrets, so anyone holding it could sign anything and
      have it validate as "Serenity Software" on every machine that ticked the box.
      Retired ahead of the repo going public; a purchased certificate replaces it.

      Nothing was deleted. Build with the preprocessor variable defined to get it
      back verbatim:

          dotnet build RunAsHelper.sln -c Release -p:DefineConstants=InstallCertFeature=1

      Four blocks are gated on InstallCertFeature: CertFileComponent and its
      ComponentRef above, the property and actions below, the InstallUISequence
      Show, and the CertDlg dialog. Re-instating means defining the variable, not
      editing the markup.

      Original behaviour, for whoever turns it back on:
      OFF by default. INSTALLCERT is left UNSET so the CertDlg checkbox renders
      unchecked — an MSI checkbox is checked whenever its bound property is non-empty,
      so a default of "0" would (wrongly) show as ticked. Opt in via the checkbox
      (which sets it to "1") or INSTALLCERT=1 on the msiexec command line. When set, a
      deferred custom action runs as SYSTEM after the files are laid down and imports
      the bundled public certificate into LocalMachine\Root via certutil, so Windows
      validates the app's signature as a verified "Serenity Software" publisher on this
      machine. Best-effort (Return="ignore") so a certutil failure never fails the
      install; not undone on uninstall. The command reaches the deferred action as
      CustomActionData because the SetProperty Id matches the deferred action's Id. -->
    <?ifdef InstallCertFeature ?>
    <Property Id="INSTALLCERT" Secure="yes" />

    <SetProperty Id="ImportSerenityCert"
                 Sequence="execute"
                 Before="ImportSerenityCert"
                 Value="&quot;[System64Folder]certutil.exe&quot; -addstore -f Root &quot;[INSTALLFOLDER]serenity-software.cer&quot;"
                 Condition="INSTALLCERT=1 AND NOT Installed" />

    <CustomAction Id="ImportSerenityCert"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ImportSerenityCert" After="InstallFiles"
              Condition="INSTALLCERT=1 AND NOT Installed" />
    </InstallExecuteSequence>
    <?endif?>

    <!-- ── Where the certificate page appears ────────────────────────────────
      CertDlg is SCHEDULED here rather than chained off the welcome page's button,
      and that distinction is the whole bug this replaced.

      It used to be published as a NewDialog on WelcomeEulaDlg's Install button at
      Order="10". MSI runs a control's events in Ordering order and stops at the
      first one that closes the dialog, and WixUI_Minimal already publishes
      "EndDialog Return" on that same button at Ordering=2. So the install always
      began at order 2 and the page at order 10 was unreachable. Verified against
      the shipped 2.1.1 MSI's ControlEvent table, which is why no released build
      has ever shown it.

      1294 is free: the surrounding InstallUISequence entries are
      MigrateFeatureStates (1200), WelcomeDlg (1295, patch-only), WelcomeEulaDlg
      (1296), ProgressDlg (1299). Sitting before the licence page keeps the button
      labels honest, Next here and Install there, and means nothing has been
      decided by the time the question is asked.

      A dialog's "EndDialog Return" returns control to this sequence rather than
      ending it, which is how ProgressDlg still follows the licence page. -->
    <!-- ── Prerequisite page ────────────────────────────────────────────────
      Shown only when the runtime is missing, at 1293 so it lands before the
      certificate page's old 1294 slot and before WelcomeEulaDlg at 1296. There
      is no Next button: the only way forward is Try Again succeeding, which
      cannot happen until the runtime is actually present.

      AppSearch runs at sequence 50, so DOTNETHOSTVERSION is already populated
      by the time this is evaluated.
    -->
    <InstallUISequence>
      <Show Dialog="PrereqDlg" Sequence="1293"
            Condition="NOT Installed AND NOT DOTNETHOSTVERSION" />
      <?ifdef InstallCertFeature ?>
      <Show Dialog="CertDlg" Sequence="1294" Condition="NOT Installed" />
      <?endif?>
    </InstallUISequence>

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <!--
        Try Again RESTARTS setup rather than re-running the search in place.

        The obvious implementation, publishing DoAction with AppSearch, does not
        work. The DoAction ControlEvent documentation describes its argument as
        "the name of the custom action to be executed", and a standard action is
        not a custom action. Tested against this package with the search pointed
        at a key that was created between clicks, with and without explicit
        control-event Order: the property never repopulated and the button did
        nothing. It looked like a working button, which is worse than no button.

        AppSearch does run, reliably, at sequence 50 of a NEW install session. So
        the button launches a fresh msiexec against [OriginalDatabase] and ends
        this one. The re-detection is therefore real rather than cosmetic. No
        mutex conflict: this session never reaches the execute sequence, and
        _MSIExecute is only held during execution.
      -->
      <Dialog Id="PrereqDlg" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}.NET 10 Desktop Runtime required" />
        <Control Id="Description" Type="Text" X="25" Y="42" Width="320" Height="80" NoPrefix="yes"
                 Text="RunAS Helper needs the Microsoft .NET 10 Desktop Runtime (x64), which is not installed on this computer. Setup cannot continue without it.&#13;&#10;&#13;&#10;Download and install the &quot;.NET Desktop Runtime 10.x&quot; x64 package, then choose Recheck. Recheck restarts Setup, so this window will close and a new one will open." />
        <Control Id="DownloadLink" Type="Hyperlink" X="25" Y="126" Width="320" Height="18" Transparent="yes">
          <Text Value="&lt;a href=&quot;https://dotnet.microsoft.com/download/dotnet/10.0&quot;&gt;https://dotnet.microsoft.com/download/dotnet/10.0&lt;/a&gt;" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <!-- "Recheck", not "Try Again": it restarts Setup rather than retrying in
             place, and the outgoing window says "Setup Wizard was interrupted".
             Under the honest label that reads as expected; under "Try Again" it
             reads as the button having failed. -->
        <Control Id="Retry" Type="PushButton" X="212" Y="243" Width="80" Height="17" Default="yes" Text="Recheck">
          <Publish Event="DoAction" Value="RelaunchSetup" Order="1" />
          <Publish Event="EndDialog" Value="Exit" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <?ifdef InstallCertFeature ?>
      <Dialog Id="CertDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Trust the app's certificate (optional)" />
        <Control Id="Description" Type="Text" X="25" Y="42" Width="320" Height="72" NoPrefix="yes"
                 Text="RunAS Helper is signed by a self-signed &quot;Serenity Software&quot; certificate. Adding that certificate to this machine's Trusted Root store makes Windows show a verified publisher and removes the &quot;Unknown publisher&quot; warning for the app's signature.&#13;&#10;&#13;&#10;This trusts anything signed by that certificate on this computer, and is left in place if you later uninstall. Leave it unchecked to install without changing the machine's trust." />
        <Control Id="InstallCertCheckBox" Type="CheckBox" X="25" Y="124" Width="320" Height="18"
                 Property="INSTALLCERT" CheckBoxValue="1"
                 Text="Trust the Serenity Software certificate on this machine" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <!-- No Back button: this is the first page of the sequence, and a sequenced
             dialog cannot NewDialog its way back to one. Next returns control to
             the UI sequence, which then shows the licence page. No elevation shield
             here, because nothing is installed until the page after this one. -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <?endif?>
    </UI>

  </Package>
</Wix>
