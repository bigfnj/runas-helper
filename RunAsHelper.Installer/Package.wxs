<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build: Build the solution in VS (Release|x64). The installer project
  publishes both apps as self-contained single-file win-x64 binaries
  before the WiX compiler runs, so no external .NET runtime is required
  on target machines.

  Install silently:  msiexec /i RunAsHelper-Setup.msi /passive
  Uninstall:         msiexec /x RunAsHelper-Setup.msi /passive
-->

<?define ServiceExe = "publish\service\RunAsHelper.Service.exe" ?>
<?define ClientExe  = "publish\client\RunAsHelper.exe" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Version binds to the packaged service EXE's FileVersion at link time, so
       the MSI version always matches the binaries. That FileVersion comes from
       the git tag for local builds (Directory.Build.props) or -p:ProductVersion
       in CI — either way there is no separate version to keep in sync here. -->
  <Package Name="RunAS Helper"
           Manufacturer="Serenity Software"
           Version="!(bind.FileVersion.ServiceExe)"
           UpgradeCode="E5F60718-C9DA-1234-EF01-5F6071829304"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RunAS Helper is already installed." />

    <!-- Apps &amp; Features entry: show the product icon instead of a blank tile. -->
    <Icon Id="RunAsHelper.ico" SourceFile="..\power.ico" />
    <Property Id="ARPPRODUCTICON" Value="RunAsHelper.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Embed the payload cabinet inside the MSI so RunAsHelper-Setup.msi is a
         single self-contained file. Without this, WiX v4 emits an external
         cab1.cab next to the MSI and install fails if it is shipped alone. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Install directory ─────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RunAsHelper">

        <!-- Windows service binary (apphost + ServiceInstall KeyPath) -->
        <Component Id="ServiceComponent" Guid="F6071829-DAEB-2345-F012-607182930415">
          <File Id="ServiceExe"
                Source="$(var.ServiceExe)"
                KeyPath="yes" />
          <ServiceInstall Id="RunASHelperInstall"
                          Type="ownProcess"
                          Name="RunASHelper"
                          DisplayName="RunAS Helper"
                          Description="Provides helper services to applications or users that require elevated privileges for systems administration and troubleshooting."
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="RunASHelperControl"
                          Name="RunASHelper"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- Tray client binary (apphost KeyPath) -->
        <Component Id="ClientComponent" Guid="07182930-EBF6-3456-0123-718293041526">
          <File Id="ClientExe"
                Source="$(var.ClientExe)"
                KeyPath="yes" />
        </Component>

        <!-- Marker that tells the tray app to run its post-install validation
             popup the first time it starts after this install. The tray reads
             it, validates, then records the version under HKCU so it shows once. -->
        <Component Id="ValidationFlagComponent" Guid="1A2B3C4D-5E6F-7081-92A3-B4C5D6E7F809">
          <RegistryValue Root="HKLM"
                         Key="Software\RunAsHelper"
                         Name="PendingValidation"
                         Type="string"
                         Value="[ProductVersion]"
                         KeyPath="yes" />
        </Component>

        <!-- Registers the event source so EventLogHelper can write structured
             entries (IDs 1001–1005) to the Application log without requiring
             CreateEventSource at runtime. ForceDeleteOnUninstall removes the
             key (and its log entries) when the product is uninstalled. -->
        <Component Id="EventSourceComponent" Guid="2B3C4D5E-6F70-8192-A3B4-C5D6E7F80912">
          <RegistryKey Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\RunAsHelper"
                       ForceDeleteOnUninstall="yes">
            <RegistryValue Name="TypesSupported" Type="integer" Value="7" KeyPath="yes" />
          </RegistryKey>
        </Component>

        <!-- The public code-signing certificate, installed next to the app so the
             optional trust step can import it and so it stays available for a manual
             import later. Public key only — safe to ship. -->
        <Component Id="CertFileComponent" Guid="4D5E6F70-8192-A3B4-C5D6-E7F8091A2B3C">
          <File Id="SerenityCer" Source="..\signing\serenity-software.cer" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- ── Start Menu shortcut ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RunAsHelperMenuFolder" Name="RunAS Helper">
        <Component Id="StartMenuComponent" Guid="28394150-7081-6789-3456-940516370748">
          <Shortcut Id="StartMenuShortcut"
                    Name="RunAS Helper"
                    Target="[INSTALLFOLDER]RunAsHelper.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RunAsHelperMenuFolderRemove" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\RunAsHelper"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- No scheduled task. Elevation is on-demand via the tray's Activate flow,
         and the tray registers its own per-user login auto-start (HKCU Run, tray
         icon only) on first run — so there is no elevated, Administrators-keyed
         logon task for endpoint security tooling to flag. -->

    <!-- ── Feature ───────────────────────────────────────────────────── -->
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ClientComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentRef Id="ValidationFlagComponent" />
      <ComponentRef Id="EventSourceComponent" />
      <ComponentRef Id="CertFileComponent" />
    </Feature>

    <!-- ── User interface ────────────────────────────────────────────────
      Without an authored UI the MSI runs with only the bare "basic" progress
      window when double-clicked: no Welcome, no Progress dialog (so the
      "Starting services…" step is invisible), and no Finish dialog. WixUI_Minimal
      gives a Welcome+License page, a real Progress dialog, and an Exit dialog.
      The WixToolset.UI.wixext package reference (in the .wixproj) supplies it.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Exit-dialog "Launch RunAS Helper" checkbox. CHECKED by default: it starts
         the tray (non-elevated, in the installing user's session) right after
         install. That first run also registers the login auto-start (an HKCU Run
         entry that opens the tray icon only), so it comes up on its own at every
         later sign-in. The old reason to leave it off (a non-elevated tray
         blocking the elevated logon scheduled-task instance via the single-instance
         mutex) no longer applies: the app now elevates on demand via the Activate
         flow rather than relying on the logon task. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch RunAS Helper now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Launch the tray as the (impersonated) installing user, so it appears on that
         user's desktop, passing the postinstall switch (see ExeCommand below). That
         switch is what triggers the one-time Installation Check popup: the tray shows
         it ONLY when the installer started it this way, never on an ordinary open, the
         elevation hand-off, or the login tray start. This is an exe custom action rather
         than util's WixShellExec because WixShellExec ShellExecutes WixShellExecTarget
         as a bare file and offers no way to pass arguments. Return is asyncNoWait so a
         launch failure can never fail the install. -->
    <CustomAction Id="LaunchApplication"
                  FileRef="ClientExe"
                  ExeCommand="--postinstall"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- ── Optional: trust the self-signed code-signing certificate ─────────
      OFF by default. INSTALLCERT is left UNSET so the CertDlg checkbox renders
      unchecked — an MSI checkbox is checked whenever its bound property is non-empty,
      so a default of "0" would (wrongly) show as ticked. Opt in via the checkbox
      (which sets it to "1") or INSTALLCERT=1 on the msiexec command line. When set, a
      deferred custom action runs as SYSTEM after the files are laid down and imports
      the bundled public certificate into LocalMachine\Root via certutil, so Windows
      validates the app's signature as a verified "Serenity Software" publisher on this
      machine. Best-effort (Return="ignore") so a certutil failure never fails the
      install; not undone on uninstall. The command reaches the deferred action as
      CustomActionData because the SetProperty Id matches the deferred action's Id. -->
    <Property Id="INSTALLCERT" Secure="yes" />

    <SetProperty Id="ImportSerenityCert"
                 Sequence="execute"
                 Before="ImportSerenityCert"
                 Value="&quot;[System64Folder]certutil.exe&quot; -addstore -f Root &quot;[INSTALLFOLDER]serenity-software.cer&quot;"
                 Condition="INSTALLCERT=1 AND NOT Installed" />

    <CustomAction Id="ImportSerenityCert"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ImportSerenityCert" After="InstallFiles"
              Condition="INSTALLCERT=1 AND NOT Installed" />
    </InstallExecuteSequence>

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <!-- Insert an optional certificate-trust page between the welcome/EULA and the
           install. WelcomeEulaDlg's Install button advances to CertDlg once the
           licence is accepted; CertDlg's Install begins the installation. -->
      <Publish Dialog="WelcomeEulaDlg" Control="Install" Event="NewDialog" Value="CertDlg"
               Order="10" Condition="LicenseAccepted = &quot;1&quot;" />

      <Dialog Id="CertDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Trust the app's certificate (optional)" />
        <Control Id="Description" Type="Text" X="25" Y="42" Width="320" Height="72" NoPrefix="yes"
                 Text="RunAS Helper is signed by a self-signed &quot;Serenity Software&quot; certificate. Adding that certificate to this machine's Trusted Root store makes Windows show a verified publisher and removes the &quot;Unknown publisher&quot; warning for the app's signature.&#13;&#10;&#13;&#10;This trusts anything signed by that certificate on this computer, and is left in place if you later uninstall. Leave it unchecked to install without changing the machine's trust." />
        <Control Id="InstallCertCheckBox" Type="CheckBox" X="25" Y="124" Width="320" Height="18"
                 Property="INSTALLCERT" CheckBoxValue="1"
                 Text="Trust the Serenity Software certificate on this machine" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeEulaDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" ElevationShield="yes" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

  </Package>
</Wix>
