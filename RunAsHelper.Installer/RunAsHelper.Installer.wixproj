<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>RunAsHelper-Setup</OutputName>
    <!--
      ICE03 fires because the deferred scheduled-task CustomAction stores a
      ~400-char PowerShell command in the CustomAction.Target column (declared
      max 255). Windows Installer reads the full string at runtime and does not
      truncate it, so the task is created correctly; the warning is cosmetic.
    -->
    <SuppressIces>ICE03</SuppressIces>

    <!--
      MSI ProductVersion. Defaults to 1.0.0.0 for local builds; the release
      workflow overrides it from the git tag (-p:ProductVersion=1.2.3) so each
      release ships a higher version and MajorUpgrade detects the upgrade.
    -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.5" />
  </ItemGroup>
  <!-- ProjectReferences establish solution build order only. The published
       single-file EXEs the installer actually packages come from the
       PublishApps target below, not from these reference outputs. -->
  <ItemGroup>
    <ProjectReference Include="..\RunAsHelper\RunAsHelper.csproj"
                      AdditionalProperties="Platform=AnyCPU" />
    <ProjectReference Include="..\RunAsHelper.Service\RunAsHelper.Service.csproj"
                      AdditionalProperties="Platform=AnyCPU" />
  </ItemGroup>

  <!--
    Self-contained single-file publish of both apps into this installer
    project's own publish\service\ and publish\client\ folders (git-ignored).

    Hooked BeforeTargets="CoreCompile" — that is the target that invokes the
    WiX linker and resolves the File @Source paths. The previous hook,
    BeforeTargets="Build", ran AFTER CoreCompile had already tried (and failed)
    to find the EXEs, which is why the installer never built from a clean tree.

    The relative Source paths in Package.wxs (publish\service\…, publish\client\…)
    resolve against the installer project directory, a default WiX bind path.
    No .NET runtime is required on the target machine.
  -->
  <Target Name="PublishApps" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RunAsHelper.Service\RunAsHelper.Service.csproj&quot; -c $(Configuration) -r win-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(MSBuildThisFileDirectory)publish\service\&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RunAsHelper\RunAsHelper.csproj&quot; -c $(Configuration) -r win-x64 --self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(MSBuildThisFileDirectory)publish\client\&quot;" />
  </Target>
</Project>
