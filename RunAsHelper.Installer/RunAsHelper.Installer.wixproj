<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>RunAsHelper-Setup</OutputName>
    <!-- Build a 64-bit package: the apps are win-x64, so the MSI should be x64 too.
         This makes ProgramFiles6432Folder resolve to C:\Program Files (not the
         (x86) folder) and keeps registry components on the 64-bit view. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!--
      MSI ProductVersion. Defaults to 1.0.0.0 for local builds; the release
      workflow overrides it from the git tag (-p:ProductVersion=1.2.3) so each
      release ships a higher version and MajorUpgrade detects the upgrade.
    -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.5" />
  </ItemGroup>
  <!-- ProjectReferences establish solution build order only. The published
       single-file EXEs the installer actually packages come from the
       PublishApps target below, not from these reference outputs. -->
  <ItemGroup>
    <ProjectReference Include="..\RunAsHelper\RunAsHelper.csproj"
                      AdditionalProperties="Platform=AnyCPU" />
    <ProjectReference Include="..\RunAsHelper.Service\RunAsHelper.Service.csproj"
                      AdditionalProperties="Platform=AnyCPU" />
  </ItemGroup>

  <!--
    Framework-dependent single-file publish of both apps into this installer
    project's own publish\service\ and publish\client\ folders (git-ignored).

    Hooked BeforeTargets="CoreCompile" — that is the target that invokes the
    WiX linker and resolves the File @Source paths. The previous hook,
    BeforeTargets="Build", ran AFTER CoreCompile had already tried (and failed)
    to find the EXEs, which is why the installer never built from a clean tree.

    The relative Source paths in Package.wxs (publish\service\…, publish\client\…)
    resolve against the installer project directory, a default WiX bind path.

    ** The .NET 10 Desktop Runtime (x64) IS required on the target machine. **
    These were self-contained through 2.1.3, which meant each EXE carried its own
    private copy of the entire runtime: 111 MB for the client and 72.5 MB for the
    service, of which roughly half a megabyte was this project's own code, for a
    65.8 MB installer. Framework-dependent brings that to 0.46 MB and 2.52 MB.
    Package.wxs carries a launch condition so a machine without the runtime is
    told so rather than installing an app that cannot start.

    Keep PublishSingleFile turned on. Package.wxs declares exactly one File per
    component, so a multi-file publish would silently omit every assembly but the
    apphost and produce an installer that lays down an EXE which cannot run.
  -->
  <Target Name="PublishApps" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RunAsHelper.Service\RunAsHelper.Service.csproj&quot; -c $(Configuration) -r win-x64 --no-self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:ProductVersion=$(ProductVersion) -o &quot;$(MSBuildThisFileDirectory)publish\service\&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RunAsHelper\RunAsHelper.csproj&quot; -c $(Configuration) -r win-x64 --no-self-contained -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:ProductVersion=$(ProductVersion) -o &quot;$(MSBuildThisFileDirectory)publish\client\&quot;" />
  </Target>

  <!--
    Optional Authenticode signing. Active only when both -p:SigningCertThumbprint
    and -p:SignToolPath are supplied (signing/Build-Signed.ps1 supplies both). A
    plain `dotnet build` leaves these empty and produces an UNSIGNED build, so
    unsigned local/CI builds still work — the service trusts the installed tray by
    image path, not by signature.

    The published EXEs are signed after PublishApps but before CoreCompile (the
    WiX link that packs them), so the signed binaries are what ends up inside the
    MSI; the MSI itself is signed after Build. Timestamping is included when
    -p:SignTimestampUrl is non-empty (default via the wrapper).
  -->
  <PropertyGroup Condition="'$(SigningCertThumbprint)' != '' and '$(SignToolPath)' != ''">
    <_SignTs Condition="'$(SignTimestampUrl)' != ''">/tr $(SignTimestampUrl) /td SHA256</_SignTs>
    <_SignArgs>sign /sha1 $(SigningCertThumbprint) /fd SHA256 $(_SignTs) /d "RunAS Helper"</_SignArgs>
  </PropertyGroup>

  <Target Name="SignPublishedApps"
          AfterTargets="PublishApps" BeforeTargets="CoreCompile"
          Condition="'$(SigningCertThumbprint)' != '' and '$(SignToolPath)' != ''">
    <Message Importance="high" Text="Signing published EXEs with cert $(SigningCertThumbprint)..." />
    <Exec Command="&quot;$(SignToolPath)&quot; $(_SignArgs) &quot;$(MSBuildThisFileDirectory)publish\service\RunAsHelper.Service.exe&quot; &quot;$(MSBuildThisFileDirectory)publish\client\RunAsHelper.exe&quot;" />
  </Target>

  <Target Name="SignMsi"
          AfterTargets="Build"
          Condition="'$(SigningCertThumbprint)' != '' and '$(SignToolPath)' != ''">
    <Message Importance="high" Text="Signing MSI $(OutDir)$(OutputName).msi ..." />
    <Exec Command="&quot;$(SignToolPath)&quot; $(_SignArgs) &quot;$(OutDir)$(OutputName).msi&quot;" />
  </Target>
</Project>
