<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console subsystem: the shell waits for this binary, unlike the WinExe tray. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Distinct from RunAsHelper so bin/ and publish/ output never collides with the
         tray exe; the shipping name RunAsHelper.com is applied after publish below. -->
    <AssemblyName>RunAsHelper.Launcher</AssemblyName>
    <RootNamespace>RunAsHelper.Launcher</RootNamespace>
    <AssemblyTitle>RunAS Helper command-line launcher</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\power.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProjectGuid>{7B1C2D3E-4F50-4A61-9B72-83C4D5E6F701}</ProjectGuid>
  </PropertyGroup>

  <!-- The SDK names a single-file bundle $(AssemblyName).exe and offers no way to change
       the apphost extension, so the rename happens here, after Publish. Every publish of
       this project (dev, CI, installer) therefore yields the exact file that ships and is
       signed: RunAsHelper.com. Copy then Delete, so a re-run is deterministic. -->
  <Target Name="RenameLauncherToCom" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_LauncherPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_LauncherPublishDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_LauncherPublishDir)$(AssemblyName).exe"
          DestinationFiles="$(_LauncherPublishDir)RunAsHelper.com"
          SkipUnchangedFiles="false" />
    <Delete Files="$(_LauncherPublishDir)$(AssemblyName).exe" />
    <Message Importance="high" Text="RunAsHelper.Launcher: published $(_LauncherPublishDir)RunAsHelper.com" />
  </Target>
</Project>
