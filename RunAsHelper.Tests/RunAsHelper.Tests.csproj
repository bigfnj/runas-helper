<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RunAsHelper.Tests</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
  </ItemGroup>

  <!-- The code under test is linked in, the same way the two apps link the protocol files.
       Everything linked here must depend only on the base class library and on each other:
       no Win32, no WinForms, no PipeClient. A new dependency in one of these files breaks this
       build, which is the alarm we want. Files that another slice adds are conditional so the
       project builds in every worktree before integration. -->
  <ItemGroup>
    <Compile Include="..\RunAsHelper.Shared\Protocol\PipeMessages.cs" Link="Linked\PipeMessages.cs" />
    <Compile Include="..\RunAsHelper.Shared\Protocol\PipeProtocol.cs" Link="Linked\PipeProtocol.cs" />
    <Compile Include="..\RunAsHelper\HelpText.cs" Link="Linked\HelpText.cs" />
    <Compile Include="..\RunAsHelper\Core\PowerShellHost.cs" Link="Linked\PowerShellHost.cs"
             Condition="Exists('..\RunAsHelper\Core\PowerShellHost.cs')" />
    <Compile Include="..\RunAsHelper\Core\CliLaunchResult.cs" Link="Linked\CliLaunchResult.cs"
             Condition="Exists('..\RunAsHelper\Core\CliLaunchResult.cs')" />
    <Compile Include="..\RunAsHelper.Service\Core\CaptureDecoder.cs" Link="Linked\CaptureDecoder.cs"
             Condition="Exists('..\RunAsHelper.Service\Core\CaptureDecoder.cs')" />
    <Compile Include="..\RunAsHelper.Launcher\LauncherLogic.cs" Link="Linked\LauncherLogic.cs"
             Condition="Exists('..\RunAsHelper.Launcher\LauncherLogic.cs')" />
  </ItemGroup>
</Project>
