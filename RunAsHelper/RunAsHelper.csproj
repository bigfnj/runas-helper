<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\power.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RunAsHelper</AssemblyName>
    <RootNamespace>RunAsHelper</RootNamespace>
    <ProjectGuid>{A3F9C841-B78E-4E3C-9A5D-1B2C3D4E5F60}</ProjectGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RunAsHelper.Shared\Protocol\PipeMessages.cs" Link="Protocol\PipeMessages.cs" />
    <Compile Include="..\RunAsHelper.Shared\Protocol\PipeProtocol.cs" Link="Protocol\PipeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the app icon so the form/tray icons can load it at runtime.
         ApplicationIcon only sets the EXE's Win32 icon, not Form.Icon. -->
    <EmbeddedResource Include="..\power.ico" Link="power.ico" LogicalName="power.ico" />
  </ItemGroup>
</Project>
